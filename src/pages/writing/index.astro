---
import Base from '../../layouts/Base.astro';
import { formatMonthDay, getPosts } from '../../lib';

const posts = await getPosts();

// Posts are already newest first, so years come out newest first too.
const byYear = Map.groupBy(posts, (post) => post.data.date.getUTCFullYear());
---

<Base title="Writing">
  <h1>Writing</h1>
  {
    posts.length > 0 ? (
      [...byYear].map(([year, yearPosts]) => (
        <section class="post-year-group">
          <h2 class="post-year-heading">{year}</h2>
          <ul class="post-list">
            {yearPosts.map((post) => (
              <li>
                <a href={`/writing/${post.id}/`}>{post.data.title}</a>
                <time class="post-list-date" datetime={post.data.date.toISOString()}>
                  {formatMonthDay(post.data.date)}
                </time>
              </li>
            ))}
          </ul>
        </section>
      ))
    ) : (
      <p class="muted">Nothing here yet.</p>
    )
  }
</Base>
