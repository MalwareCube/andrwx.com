---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  /** An image imported from the post's folder, e.g. `import shot from './shot.png'`. */
  src: ImageMetadata;
  alt: string;
  /** Draw a thin border around the image. */
  border?: boolean;
  /** Click to enlarge. On by default; turn off only for images that gain nothing from it. */
  lightbox?: boolean;
}

const { src, alt, border = false, lightbox = true } = Astro.props;

// In the page: 2x the 600px column. In the lightbox: up to 2400px.
const inlineWidth = Math.min(src.width, 1200);
const full = lightbox ? await getImage({ src, width: Math.min(src.width, 2400) }) : undefined;
---

<figure class="post-image">
  {
    full ? (
      <a href={full.src} class="lightbox">
        <Image src={src} alt={alt} width={inlineWidth} class:list={[{ bordered: border }]} />
      </a>
    ) : (
      <Image src={src} alt={alt} width={inlineWidth} class:list={[{ bordered: border }]} />
    )
  }
  {Astro.slots.has('default') && <figcaption class="post-image-caption"><slot /></figcaption>}
</figure>
